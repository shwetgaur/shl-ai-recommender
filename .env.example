# =========================================================================
# SHL Conversational Assessment Recommender - environment configuration
# Copy this file to `.env` and fill in what you need. Everything is optional:
# with no keys set, the service still runs using a deterministic fallback
# agent (schema-valid replies, retrieval-driven shortlists).
# =========================================================================

# --- LLM provider selection -------------------------------------------------
# Provider priority is a comma-separated list tried in order until one works.
# Supported: gemini, groq, openai
LLM_PROVIDER_PRIORITY=gemini,groq,openai

# Google Gemini (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier: https://console.groq.com/keys) - OpenAI-compatible
# llama-4-scout has 30K TPM on the free tier (vs 12K for llama-3.3-70b), which
# avoids per-minute rate limits across a full 8-turn conversation.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Generic OpenAI-compatible endpoint (OpenAI, OpenRouter, local, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval --------------------------------------------------------------
# auto = use embeddings if the model loads, else BM25 only.
# Options: auto | hybrid | lexical
RETRIEVAL_MODE=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Weight of semantic score in the hybrid blend (0..1). Lexical gets (1 - this).
HYBRID_SEMANTIC_WEIGHT=0.55
# Number of candidates surfaced by retrieval each turn.
RETRIEVAL_TOP_K=40
# How many of those candidates are actually shown to the LLM (lower = fewer
# tokens per call, which keeps you under free-tier tokens-per-minute limits).
LLM_CANDIDATE_LIMIT=12

# --- Agent behavior ---------------------------------------------------------
# Hard cap on assistant turns the evaluator allows (user+assistant <= 8).
MAX_TURNS=8
# Per-request soft budget in seconds (evaluator hard timeout is 30s).
REQUEST_BUDGET_SECONDS=25
# Max items ever returned in a shortlist.
MAX_RECOMMENDATIONS=10

# --- Data -------------------------------------------------------------------
CATALOG_PATH=data/shl_product_catalog.json
CATALOG_URL=https://tcp-us-prod-rnd.shl.com/voiceRater/shl-ai-hiring/shl_product_catalog.json
